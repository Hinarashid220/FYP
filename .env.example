# Copy this file to .env and replace the placeholder values.
# Never commit .env or paste the real App Password into source control.
SOLARSIGHT_OTP_REQUIRED=true
APP_NAME="Solar Sensing"
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=solarsensing@gmail.com
SMTP_PASSWORD=replace-with-a-new-gmail-app-password
FROM_EMAIL=solarsensing@gmail.com
OTP_EXPIRY_MINUTES=5
